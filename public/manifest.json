{
  "name": "MyBrain - AI Executive Inbox",
  "short_name": "MyBrain",
  "description": "Mobile-first AI personal and work inbox that extracts tasks, prioritizes them, and tells you what needs attention right now.",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Now & Urgent",
      "url": "/?tab=now",
      "description": "Open immediate priority items"
    },
    {
      "name": "Waiting Dashboard",
      "url": "/?tab=waiting",
      "description": "See who and what you are waiting for"
    }
  ],
  "lang": "hu",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/plain",
            ".txt"
          ]
        }
      ]
    }
  }
}
